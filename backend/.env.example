# BrandGuard AI backend configuration
# Copy to .env (the app does not auto-load .env; export the values or use a runner)

# SQLite file used for the local demo. Swap for PostgreSQL + pgvector in production.
BRANDGUARD_DB=./data/brandguard.db

# Seed demo scans so the analytics dashboard is populated on first boot (1/0)
BRANDGUARD_SEED_DEMO=1

# Allowed frontend origins (comma separated)
BRANDGUARD_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Optional: upgrade path for semantic retrieval / LLM inspection.
# The demo runs fully offline with deterministic rules + TF-IDF citations.
OPENAI_API_KEY=
